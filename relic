const RELIC_BRANCH = 'main';  // where a version comes from when no tag is given
const RELIC_FIRST = '0.1.0';  // the first version taken from main

// a spell with a value, or its default (a spell without a value is '1')
function relic_spell( String $key, String $default = '' ) {
  $value = Chanter::spell($key);
  return ($value === false || $value === '' || $value === '1') ? $default : trim((string) $value);
}

// the answer of a spell, or ask for it (--tag=1 is a tag too, so $one keeps '1')
function relic_ask( String $key, String $question, Bool $one = false ) {
  $value = Chanter::spell($key);
  if ($value !== false && $value !== '' && ($one || $value !== '1')) {
    return trim((string) $value);
  }
  return trim((string) Whisper::call("$question "));
}

function relic_api() { return rtrim(relic_spell('api', 'https://api.github.com'), '/'); }
function relic_raw() { return rtrim(relic_spell('raw', 'https://raw.githubusercontent.com'), '/'); }

function relic_line( String $state, String $text ) {
  $color = ['ok'=> 'SUCCESS', 'warn'=> 'WARNING', 'fail'=> 'DANGER', 'info'=> 'SECONDARY'][$state];
  $icon = ['ok'=> 'SUCCESS', 'warn'=> 'WARNING', 'fail'=> 'DANGER', 'info'=> 'INFO'][$state];
  Whisper::echo("{{COLOR-$color}}{{ICON-$icon}}{{COLOR-END}} $text{{nl}}");
}

// the name of the project folder: the repo of this reliquary
function relic_folder() {
  $parts = preg_split('#[\\\\/]#', rtrim(AETHER_REPO, '\\/'));
  return end($parts);
}

// the GitHub repo of this project, from .git/config (remote "origin"): [owner, repo] or null
// the folder name is not trusted: a clone can live in any folder (reliquary-anwar ...)
function relic_origin() {
  $config = @file_get_contents(AETHER_REPO . '/.git/config');
  if (!$config || !preg_match('#\[remote "origin"\][^\[]*?url\s*=\s*(\S+)#', $config, $match)) {
    return null;
  }
  if (!preg_match('#github\.com[:/]+([^/\s]+)/([^/\s]+?)(?:\.git)?/?$#i', $match[1], $repo)) {
    return null;
  }
  return [$repo[1], $repo[2]];
}

function relic_load() {
  $data = json_decode((string) Forger::item(AETHER_REPO . '/relic.json'), true);
  return is_array($data) ? $data : null;
}

function relic_save( Array $record ) {
  $record['list'] = $record['list'] ?: new stdClass;
  $json = json_encode($record, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
  $json = preg_replace_callback('/^( +)/m', fn($match) => str_repeat(' ', strlen($match[1]) / 2), $json); // 2 spaces
  return Forger::item(AETHER_REPO . '/relic.json', str_replace("\n", "\r\n", $json) . "\r\n");
}

// this reliquary: relic.json with its "main", or a hint to run initiate
function relic_self() {
  $record = relic_load();
  if (!$record || !preg_match('#^[^/]+/[^/]+$#', (string) ($record['main'] ?? ''))) {
    relic_line('warn', 'relic.json has no "main", run: php relic initiate');
    return null;
  }
  $record['list'] = is_array($record['list'] ?? null) ? $record['list'] : [];
  return $record;
}

// the key of a listed relic (any case), or null
function relic_key( Array $list, String $name ) {
  foreach (array_keys($list) as $key) {
    if (strcasecmp($key, $name) === 0) {
      return $key;
    }
  }
  return null;
}

// GET a url: [status, body]; status 0 = can not be reached
function relic_fetch( String $url, Bool $api = false ) {
  $headers = ['User-Agent: rune-reliquary'];
  if ($api) {
    $headers[] = 'Accept: application/vnd.github+json';
    if (getenv('GITHUB_TOKEN')) {
      $headers[] = 'Authorization: Bearer ' . getenv('GITHUB_TOKEN');
    }
  }
  if (function_exists('curl_init')) {
    $curl = curl_init($url);
    curl_setopt_array($curl, [
      CURLOPT_RETURNTRANSFER=> true,
      CURLOPT_FOLLOWLOCATION=> true,
      CURLOPT_TIMEOUT=> 30,
      CURLOPT_HTTPHEADER=> $headers,
    ]);
    $body = curl_exec($curl);
    $status = (int) curl_getinfo($curl, CURLINFO_RESPONSE_CODE);
    curl_close($curl);
    return [$body === false ? 0 : $status, $body === false ? '' : $body];
  }
  if (ini_get('allow_url_fopen')) {
    $context = stream_context_create(['http'=> [
      'timeout'=> 30,
      'header'=> implode("\r\n", $headers),
      'follow_location'=> 1,
      'ignore_errors'=> true,
    ]]);
    $body = @file_get_contents($url, false, $context);
    $status = 0;
    foreach ($http_response_header ?? [] as $line) {
      if (preg_match('#^HTTP/\S+\s+(\d{3})#', $line, $match)) {
        $status = (int) $match[1]; // the last status wins (after redirects)
      }
    }
    return [$body === false ? 0 : $status, $body === false ? '' : $body];
  }
  relic_line('fail', 'PHP can not go online: enable curl (or allow_url_fopen) in php.ini');
  return [0, ''];
}

/* Where a version rests: a tag, or the last commit of main.
 * A version taken from main points to its commit, so the seal never breaks
 * when main moves on. Returns [ref, ref for the record] or a problem string. */
function relic_ref( String $name, String $tag ) {
  if ($tag !== '') {
    if (in_array(strtolower($tag), ['main', 'master'])) {
      return "'$tag' is a branch, not a tag: leave it empty to take main";
    }
    return [$tag, $tag];
  }
  list($status, $body) = relic_fetch(relic_api() . "/repos/$name/commits/" . RELIC_BRANCH, true);
  $sha = $status === 200 ? (json_decode($body, true)['sha'] ?? '') : '';
  if (!preg_match('#^[0-9a-f]{40}$#', $sha)) {
    return "the last commit of $name@" . RELIC_BRANCH . " can not be read (HTTP $status)";
  }
  return [$sha, RELIC_BRANCH . '@' . substr($sha, 0, 7)];
}

// download a .rune: [url, sha256, rune version] or a problem string
function relic_take( String $name, String $runite, String $ref ) {
  $url = relic_raw() . "/$name/$ref/$runite.rune";
  list($status, $body) = relic_fetch($url);
  if ($status !== 200) {
    return "$url can not be fetched (HTTP $status)";
  }
  if (strpos($body, '[ᚱᚾ]') === false) {
    return "$url is not a relic (.rune)";
  }
  preg_match('#::version=([0-9.]+)#', $body, $match);
  return [$url, hash('sha256', $body), $match[1] ?? null];
}

// the next patch of the last version: 0.1.0 -> 0.1.1
function relic_patch( Array $tags ) {
  $last = null;
  foreach (array_keys($tags) as $version) {
    if (preg_match('#^v?\d+\.\d+\.\d+$#', (string) $version) && ($last === null || version_compare(ltrim($version, 'v'), ltrim($last, 'v'), '>'))) {
      $last = (string) $version;
    }
  }
  if ($last === null) {
    return null;
  }
  $prefix = $last[0] === 'v' ? 'v' : '';
  list($major, $minor, $patch) = explode('.', ltrim($last, 'v'));
  return [$last, $prefix . $major . '.' . $minor . '.' . ((int) $patch + 1)];
}

/* Publish relic.json: git add, commit and push, cast by Specter.
 * Only relic.json is added. --local keeps it on this computer. */
function relic_publish( String $action ) {
  if (Chanter::spell('local')) {
    relic_line('info', 'relic.json is saved, not pushed (--local)');
    return;
  }
  if (!is_dir(AETHER_REPO . '/.git')) {
    relic_line('warn', 'Not a git repo: relic.json is saved, push it yourself');
    return;
  }
  if (trim((string) shell_exec('git status --porcelain -- relic.json 2>&1')) === '') {
    relic_line('info', 'relic.json has not changed, nothing to push');
    return;
  }
  $message = "feat: $action " . date('Y-m-d H:i');
  Whisper::echo("{{nl}}{{COLOR-SECONDARY}}git add relic.json · commit · push{{COLOR-END}}{{nl}}");
  Specter::cast('git add relic.json && git commit -m "' . $message . '" && git push', [
    'blocking'=> true,  // one after another, then back here
    'visible'=> false,  // in this terminal
    'exit'=> true,
    'title'=> 'RELIC',
  ]);

  // Specter gives no answer back: ask git what happened
  $last = trim((string) shell_exec('git log -1 --format=%s 2>&1'));
  $state = trim((string) shell_exec('git status -sb 2>&1'));
  $pending = trim((string) shell_exec('git status --porcelain -- relic.json 2>&1'));
  if ($pending !== '' || $last !== $message) {
    relic_line('fail', 'relic.json is saved but not committed: git add relic.json && git commit && git push');
  }elseif (preg_match('#\[ahead \d+#', strtok($state, "\n"))) {
    relic_line('fail', "Committed ($message) but not pushed: git pull --rebase && git push");
  }else {
    relic_line('ok', "relic.json is pushed · $message");
  }
}

/* Take a version and add it to the tags of a relic (a version never changes once listed).
 * Returns the relic, or null when nothing was added. */
function relic_add( Array $relic, String $name, String $runite, String $tag, ?String $version ) {
  $ref = relic_ref($name, $tag);
  if (is_string($ref)) {
    relic_line('fail', $ref);
    return null;
  }
  $taken = relic_take($name, $runite, $ref[0]);
  if (is_string($taken)) {
    relic_line('fail', $taken);
    return null;
  }
  list($url, $sha256, $rune) = $taken;
  $tags = $relic['tags'] ?? [];

  // from main: nothing new when main still holds the same relic
  if ($tag === '') {
    foreach ($tags as $listed => $item) {
      if (($item['sha256'] ?? '') === $sha256) {
        relic_line('info', "$name: " . RELIC_BRANCH . " holds the same relic as $listed, nothing to upgrade");
        return null;
      }
    }
  }
  $version = $version ?? $tag;
  if (isset($tags[$version])) {
    if (($tags[$version]['sha256'] ?? '') === $sha256) {
      relic_line('info', "$name@$version is already listed");
    }else {
      relic_line('fail', "$name@$version is already listed with another seal. A version never changes: give a new tag.");
    }
    return null;
  }

  $tags[$version] = array_filter(['url'=> $url, 'sha256'=> $sha256, 'rune'=> $rune, 'ref'=> $tag === '' ? $ref[1] : null]);
  uksort($tags, fn($a, $b) => version_compare(ltrim($a, 'v'), ltrim($b, 'v')));
  $relic['tags'] = $tags;
  relic_line('ok', "$name@$version · {$ref[1]} · sha256 " . substr($sha256, 0, 12) . '…' . ($rune ? " · Rune $rune" : ''));
  return $relic;
}




/* INITIATE
 * A fork starts with the records of its parent: clean up relic.json,
 * with <username>/<project folder> as the reliquary.
 * */
Chanter::cast(
  arg: 'initiate --user --yes --local',
  echo: 'initiate this reliquary, clean up relic.json',
  execute: function() {
    // the repo comes from git remote origin; the folder name only when there is none
    $origin = relic_origin();
    $user = relic_spell('user') ?: ($origin[0] ?? '');
    if ($user === '') {
      $user = relic_ask('user', 'Your GitHub username:');
    }
    $user = trim($user, '@/ ');
    if (!preg_match('#^[a-z0-9][a-z0-9-]*$#i', $user)) {
      relic_line('warn', 'A GitHub username is needed: php relic initiate --user=<username>');
      return;
    }
    $main = "$user/" . ($origin[1] ?? relic_folder());
    if ($origin) {
      relic_line('info', "git remote origin: {$origin[0]}/{$origin[1]}");
    }

    $record = relic_load();
    $count = count((array) ($record['list'] ?? []));
    if ($count && !Chanter::spell('yes')) {
      $from = $record['main'] ?? 'relic.json';
      if (strtolower(trim((string) Whisper::call("Clean up $count relic(s) of $from? [y/n]: "))) !== 'y') {
        relic_line('info', 'relic.json is kept');
        return;
      }
    }
    relic_save(['main'=> $main, 'list'=> []]);
    relic_line('ok', "relic.json is ready: the reliquary of $main");
    relic_publish('initiate relic');
      Whisper::echo("{{COLOR-SECONDARY}}   Keep it in step with its parent: php hall sync{{COLOR-END}}{{nl}}");
  }
);


/* REGISTER
 * List a relic: <repo>/<runite> of the owner of this reliquary.
 * The version comes from a tag, or from main as 0.1.0.
 * */
Chanter::cast(
  arg: 'register --repo --tag --note --local',
  echo: 'register a relic in relic.json',
  execute: function() {
    $self = relic_self();
    if (!$self) {
      return;
    }
    $owner = explode('/', $self['main'])[0];

    $input = trim(preg_replace('#^https?://github\.com/#i', '', relic_ask('repo', 'Which repo? (e.g. exuracss/cast):')), '/');
    $parts = explode('/', $input);
    if (count($parts) === 3) {
      if (strcasecmp($parts[0], $owner) !== 0) {
        relic_line('fail', "$input: this reliquary only lists $owner/*");
        return;
      }
      array_shift($parts);
    }
    list($repo, $runite) = array_pad($parts, 2, 'cast');
    if (count($parts) > 2 || !preg_match('#^[a-z0-9._-]+$#i', $repo) || !preg_match('#^[a-z0-9._-]+$#i', $runite)) {
      relic_line('warn', 'Give the repo and its runite: <repo>/<runite>, e.g. exuracss/cast');
      return;
    }
    $name = "$owner/$repo";
    if ($key = relic_key($self['list'], $name)) {
      relic_line('info', "$key is already registered, run: php relic upgrade --repo=$repo");
      return;
    }

    $tag = relic_ask('tag', 'Which tag? (empty = ' . RELIC_BRANCH . ' as ' . RELIC_FIRST . '):', true);
    $relic = relic_add(['tags'=> []], $name, $runite, $tag, $tag === '' ? RELIC_FIRST : null);
    if (!$relic) {
      return;
    }
    $self['list'][$name] = array_filter([
      'repo'=> "https://github.com/$name",
      'runite'=> $runite,
      'note'=> relic_spell('note') ?: null,
      'tags'=> $relic['tags'],
    ]);
    ksort($self['list'], SORT_FLAG_CASE | SORT_STRING);
    relic_save($self);
    relic_line('ok', "$name registered");
    relic_publish('update relic');
  }
);


/* UPGRADE
 * A new version of a registered relic: a tag, or main as the next patch (0.1.0 -> 0.1.1).
 * The old versions stay.
 * */
Chanter::cast(
  arg: 'upgrade --repo --tag --local',
  echo: 'add a new version of a relic',
  execute: function() {
    $self = relic_self();
    if (!$self) {
      return;
    }
    if (!$self['list']) {
      relic_line('info', 'No relic yet, run: php relic register');
      return;
    }
    $owner = explode('/', $self['main'])[0];
    $keys = array_keys($self['list']);

    $input = relic_spell('repo');
    if ($input === '') {
      Whisper::echo("{{nl}}");
      foreach ($keys as $i => $key) {
        $tags = array_keys($self['list'][$key]['tags'] ?? []);
        Whisper::echo("  {{COLOR-INFO}}[" . ($i + 1) . "]{{COLOR-END}} $key · " . (end($tags) ?: 'no version') . "{{nl}}");
      }
      $input = trim((string) Whisper::call('Which relic? [ID or repo]: '));
    }
    $key = ctype_digit($input) ? ($keys[(int) $input - 1] ?? null) : null;
    $key = $key ?? relic_key($self['list'], strpos($input, '/') === false ? "$owner/$input" : $input);
    if (!$key) {
      relic_line('fail', ($input ?: 'nothing') . ' is not registered, run: php relic register');
      return;
    }
    $relic = $self['list'][$key];

    $tag = relic_ask('tag', 'Which tag? (empty = ' . RELIC_BRANCH . ' as the next patch):', true);
    $version = null;
    if ($tag === '') {
      $next = relic_patch($relic['tags'] ?? []);
      if (!$next) {
        relic_line('fail', "$key has no x.y.z version to raise, give a tag");
        return;
      }
      $version = $next[1];
    }
    $relic = relic_add($relic, $key, (string) ($relic['runite'] ?? 'cast'), $tag, $version);
    if (!$relic) {
      return;
    }
    $self['list'][$key] = $relic;
    relic_save($self);
    relic_line('ok', "$key upgraded");
    relic_publish('update relic');
  }
);



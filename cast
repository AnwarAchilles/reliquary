Aether::begin();
Chanter::begin();
Keeper::begin();


/* BUILD
 * todo bundling to website applications 
 * [i]INFO: crafting process will be reset your shard in .echoes
 * */
Chanter::cast(
  arg: 'build',
  echo: 'bundling to website applications',
  execute: function() {
    // no source, no page: an empty build would replace index.html
    if (!is_file(__DIR__ . '/src/index.html')) {
      Whisper::echo("{{COLOR-WARNING}}{{ICON-WARNING}}{{COLOR-END}} src/ is not here: index.html is kept as it is{{nl}}");
      return;
    }
    // create crafting environment
    Crafter::item('landing-pages', function() {
      // set seeds
      Crafter::seed('DIST', __DIR__ . '/index.html'); // distribution file output
      Crafter::seed('TYPE', 'plain'); // plain (HTML,CSS,JS) or function, class (PHP only)
      Crafter::seed('LANGUAGE', ['html','css','js']); // web language only 4 html, css, js, php
      
      // set multiple shards with Forger
      Forger::scan('src/exura/', function($item) {
        Crafter::shard(preg_replace('#[\\\\/]+#', '/', $item->target)); // src/exura/\exura.css (Windows) → src/exura/exura.css
      });
    
      // set shards one by one
      Crafter::shard('src/index.head.html'); // privately for HTML <head>
      Crafter::shard('src/index.html'); // HTML <body>
      Crafter::shard('src/index.css');
      Crafter::shard('src/index.js');
    });
    // run crafting
    Crafter::spark('landing-pages');
  }
);


/* WATCH
 * todo observe change in src then trigger build
 *  */
Chanter::cast(
  arg: 'watch',
  echo: 'observe change in src then trigger build',
  execute: function() {
    Specter::observer('src', function() {
      Chanter::cast('build')();
    });
  }
);


/* SERVE
 * todo start local-development server PHP
 * [i]INFO: the page reads relic.json & nexus.json next to it,
 * a browser refuses to read them from file://, so serve it.
 *  */
Chanter::cast(
  arg: 'serve',
  echo: 'start local-development server PHP',
  execute: function() {
    Specter::devserver([
      'path'=> __DIR__, // index.html, relic.json & nexus.json
    ]);
  }
);


/* START
 * todo build, then serve & watch in another process
 *  */
Chanter::cast(
  arg: 'start',
  echo: 'build, then serve & watch in another process',
  execute: function() {
    // build it first
    Chanter::cast('build')();
    // run serve with specter cast
    Specter::cast('{{self}} serve', [
      'exit' => true,
      'title'=> 'RUNE:: Local Development Server'
    ]);
    // run watch with specter cast
    Specter::cast('{{self}} watch', [
      'exit' => true,
      'title'=> 'RUNE:: Observer Directories'
    ]);
    // all of specter.cast is non-blocking execution
  }
);


/* PUBLISH
 * todo commit your page and push it, cast by Specter
 * [i]INFO: only index.html & cast.rune are added
 *  */
Chanter::cast(
  arg: 'publish',
  echo: 'commit your page (index.html, cast.rune) and push it',
  execute: function() {
    if (!is_dir(__DIR__ . '/.git')) {
      Whisper::echo("{{COLOR-WARNING}}{{ICON-WARNING}}{{COLOR-END}} Not a git repo: push your page yourself{{nl}}");
      return;
    }
    $files = array_values(array_filter(['index.html', 'cast.rune'], fn($file) => is_file(__DIR__ . "/$file")));
    $list = implode(' ', $files);
    if (!$files || trim((string) shell_exec("git status --porcelain -- $list 2>&1")) === '') {
      Whisper::echo("{{COLOR-SECONDARY}}{{ICON-INFO}}{{COLOR-END}} Your page has not changed, nothing to push{{nl}}");
      return;
    }
    $message = 'feat: update page ' . date('Y-m-d H:i');
    Whisper::echo("{{nl}}{{COLOR-SECONDARY}}git add $list · commit · push{{COLOR-END}}{{nl}}");
    Specter::cast("git add $list && git commit -m \"$message\" && git push", [
      'blocking'=> true,  // one after another, then back here
      'visible'=> false,  // in this terminal
      'exit'=> true,
      'title'=> 'PUBLISH',
    ]);

    // Specter gives no answer back: ask git what happened
    $last = trim((string) shell_exec('git log -1 --format=%s 2>&1'));
    $state = trim((string) shell_exec('git status -sb 2>&1'));
    $pending = trim((string) shell_exec("git status --porcelain -- $list 2>&1"));
    if ($pending !== '' || $last !== $message) {
      Whisper::echo("{{COLOR-DANGER}}{{ICON-DANGER}}{{COLOR-END}} Your page is not committed: git add $list && git commit && git push{{nl}}");
    }elseif (preg_match('#\[ahead \d+#', strtok($state, "\n"))) {
      Whisper::echo("{{COLOR-DANGER}}{{ICON-DANGER}}{{COLOR-END}} Committed ($message) but not pushed: git pull --rebase && git push{{nl}}");
    }else {
      Whisper::echo("{{COLOR-SUCCESS}}{{ICON-SUCCESS}}{{COLOR-END}} Your page is pushed · $message{{nl}}");
    }
  }
);



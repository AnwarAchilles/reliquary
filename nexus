const NEXUS_DEPTH = 10; // forks of forks, how deep the chain is followed

// a spell with a value, or its default (a spell without a value is '1')
function nexus_spell( String $key, String $default = '' ) {
  $value = Chanter::spell($key);
  return ($value === false || $value === '' || $value === '1') ? $default : trim((string) $value);
}

// the answer of a spell, or ask for it
function nexus_ask( String $key, String $question ) {
  return nexus_spell($key) ?: trim((string) Whisper::call("$question "));
}

function nexus_api() { return rtrim(nexus_spell('api', 'https://api.github.com'), '/'); }
function nexus_raw() { return rtrim(nexus_spell('raw', 'https://raw.githubusercontent.com'), '/'); }

function nexus_line( String $state, String $text ) {
  $color = ['ok'=> 'SUCCESS', 'warn'=> 'WARNING', 'fail'=> 'DANGER', 'info'=> 'SECONDARY'][$state];
  $icon = ['ok'=> 'SUCCESS', 'warn'=> 'WARNING', 'fail'=> 'DANGER', 'info'=> 'INFO'][$state];
  Whisper::echo("{{COLOR-$color}}{{ICON-$icon}}{{COLOR-END}} $text{{nl}}");
}

// the name of the project folder: the repo of this reliquary
function nexus_folder() {
  $parts = preg_split('#[\\\\/]#', rtrim(AETHER_REPO, '\\/'));
  return end($parts);
}

// the GitHub repo of this project, from .git/config (remote "origin"): [owner, repo] or null
// the folder name is not trusted: a clone can live in any folder (reliquary-anwar ...)
function nexus_origin() {
  $config = @file_get_contents(AETHER_REPO . '/.git/config');
  if (!$config || !preg_match('#\[remote "origin"\][^\[]*?url\s*=\s*(\S+)#', $config, $match)) {
    return null;
  }
  if (!preg_match('#github\.com[:/]+([^/\s]+)/([^/\s]+?)(?:\.git)?/?$#i', $match[1], $repo)) {
    return null;
  }
  return [$repo[1], $repo[2]];
}

function nexus_json( String $text ) {
  $data = json_decode($text, true);
  return is_array($data) ? $data : null;
}

function nexus_load() {
  return nexus_json((string) Forger::item(AETHER_REPO . '/nexus.json'));
}

function nexus_save( Array $record ) {
  $record['list'] = $record['list'] ?: new stdClass;
  $json = json_encode($record, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
  $json = preg_replace_callback('/^( +)/m', fn($match) => str_repeat(' ', strlen($match[1]) / 2), $json); // 2 spaces
  return Forger::item(AETHER_REPO . '/nexus.json', str_replace("\n", "\r\n", $json) . "\r\n");
}

// this reliquary: nexus.json with its "main", or a hint to run initiate
function nexus_self() {
  $record = nexus_load();
  if (!$record || !preg_match('#^[^/]+/[^/]+$#', (string) ($record['main'] ?? ''))) {
    nexus_line('warn', 'nexus.json has no "main", run: php nexus initiate');
    return null;
  }
  $record['list'] = is_array($record['list'] ?? null) ? $record['list'] : [];
  return $record;
}

// GET a url: [status, body]; status 0 = can not be reached
function nexus_fetch( String $url, Bool $api = false ) {
  $headers = ['User-Agent: rune-reliquary'];
  if ($api) {
    $headers[] = 'Accept: application/vnd.github+json';
    if (getenv('GITHUB_TOKEN')) {
      $headers[] = 'Authorization: Bearer ' . getenv('GITHUB_TOKEN');
    }
  }
  if (function_exists('curl_init')) {
    $curl = curl_init($url);
    curl_setopt_array($curl, [
      CURLOPT_RETURNTRANSFER=> true,
      CURLOPT_FOLLOWLOCATION=> true,
      CURLOPT_TIMEOUT=> 30,
      CURLOPT_HTTPHEADER=> $headers,
    ]);
    $body = curl_exec($curl);
    $status = (int) curl_getinfo($curl, CURLINFO_RESPONSE_CODE);
    curl_close($curl);
    return [$body === false ? 0 : $status, $body === false ? '' : $body];
  }
  if (ini_get('allow_url_fopen')) {
    $context = stream_context_create(['http'=> [
      'timeout'=> 30,
      'header'=> implode("\r\n", $headers),
      'follow_location'=> 1,
      'ignore_errors'=> true,
    ]]);
    $body = @file_get_contents($url, false, $context);
    $status = 0;
    foreach ($http_response_header ?? [] as $line) {
      if (preg_match('#^HTTP/\S+\s+(\d{3})#', $line, $match)) {
        $status = (int) $match[1]; // the last status wins (after redirects)
      }
    }
    return [$body === false ? 0 : $status, $body === false ? '' : $body];
  }
  nexus_line('fail', 'PHP can not go online: enable curl (or allow_url_fopen) in php.ini');
  return [0, ''];
}

/* Publish nexus.json: git add, commit and push, cast by Specter.
 * Only nexus.json is added. --local keeps it on this computer. */
function nexus_publish( String $action ) {
  if (Chanter::spell('local')) {
    nexus_line('info', 'nexus.json is saved, not pushed (--local)');
    return;
  }
  if (!is_dir(AETHER_REPO . '/.git')) {
    nexus_line('warn', 'Not a git repo: nexus.json is saved, push it yourself');
    return;
  }
  if (trim((string) shell_exec('git status --porcelain -- nexus.json 2>&1')) === '') {
    nexus_line('info', 'nexus.json has not changed, nothing to push');
    return;
  }
  $message = "feat: $action " . date('Y-m-d H:i');
  Whisper::echo("{{nl}}{{COLOR-SECONDARY}}git add nexus.json · commit · push{{COLOR-END}}{{nl}}");
  Specter::cast('git add nexus.json && git commit -m "' . $message . '" && git push', [
    'blocking'=> true,  // one after another, then back here
    'visible'=> false,  // in this terminal
    'exit'=> true,
    'title'=> 'NEXUS',
  ]);

  // Specter gives no answer back: ask git what happened
  $last = trim((string) shell_exec('git log -1 --format=%s 2>&1'));
  $state = trim((string) shell_exec('git status -sb 2>&1'));
  $pending = trim((string) shell_exec('git status --porcelain -- nexus.json 2>&1'));
  if ($pending !== '' || $last !== $message) {
    nexus_line('fail', 'nexus.json is saved but not committed: git add nexus.json && git commit && git push');
  }elseif (preg_match('#\[ahead \d+#', strtok($state, "\n"))) {
    nexus_line('fail', "Committed ($message) but not pushed: git pull --rebase && git push");
  }else {
    nexus_line('ok', "nexus.json is pushed · $message");
  }
}

/* The relics of a reliquary from its relic.json.
 * Only "<owner>/*" counts: a fork inherits relic.json of its parent until it runs
 * `php relic initiate`, so names of other owners are ignored — nobody can take another name.
 * Returns [relics, problems]. */
function nexus_relics( Mixed $record, String $owner ) {
  if (!is_array($record) || !isset($record['list']) || !is_array($record['list'])) {
    return [[], ['relic.json is not a reliquary record']];
  }
  $relics = [];
  $problems = [];
  foreach ($record['list'] as $name => $relic) {
    $name = (string) $name;
    if (strcasecmp(explode('/', $name)[0], $owner) !== 0) {
      $problems[] = "$name: ignored, only $owner/* belongs here";
      continue;
    }
    if (!is_array($relic) || empty($relic['tags']) || !is_array($relic['tags'])) {
      $problems[] = "$name: has no tags";
      continue;
    }
    $relics[$name] = $relic;
  }
  return [$relics, $problems];
}

/* Every reliquary on the chain: the forks of this one, their forks... (up to NEXUS_DEPTH)
 * Each reliquary is read once. Returns [ "<owner>/<repo>" => [owner, relic, nexus, via] ]. */
function nexus_chain( Array $self ) {
  $chain = [];
  $queue = [[$self['list'], $self['main'], 1]];
  while ($queue) {
    list($list, $via, $depth) = array_shift($queue);
    foreach ((array) $list as $full_name => $fork) {
      if (isset($chain[$full_name]) || $full_name === $self['main'] || !is_array($fork)) {
        continue;
      }
      $chain[$full_name] = [
        'owner'=> (string) ($fork['owner'] ?? explode('/', $full_name)[0]),
        'relic'=> (string) ($fork['relic'] ?? ''),
        'nexus'=> (string) ($fork['nexus'] ?? ''),
        'via'=> $via,
      ];
      if ($chain[$full_name]['nexus'] !== '' && $depth < NEXUS_DEPTH) {
        list($status, $body) = nexus_fetch($chain[$full_name]['nexus']);
        $next = $status === 200 ? (nexus_json($body)['list'] ?? null) : null;
        if (is_array($next) && $next) {
          $queue[] = [$next, $full_name, $depth + 1];
        }
      }
    }
  }
  return $chain;
}




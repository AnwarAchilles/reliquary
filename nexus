);


/* UPDATE
 * nexus.json: every fork of this reliquary (GET /repos/<main>/forks, all pages).
 * Each fork is read once to count its relics; its relics stay in its own relic.json.
 * */
Chanter::cast(
  arg: 'update --local',
  echo: 'map the forks of this reliquary in nexus.json',
  execute: function() {
    $self = nexus_self();
    if (!$self) {
      return;
    }
    $main = $self['main'];
    $api = nexus_api();
    $raw = nexus_raw();
    Whisper::echo("{{nl}}{{bold}}Nexus{{end}} $main{{nl}}{{nl}}");

    $forks = [];
    for ($page = 1; $page <= 100; $page++) {
      list($status, $body) = nexus_fetch("$api/repos/$main/forks?per_page=100&page=$page", true);
      $list = $status === 200 ? nexus_json($body) : null;
      if ($list === null) {
        nexus_line('fail', "The forks of $main can not be read (HTTP $status), nexus.json is not written");
        return;
      }
      if (!$list) {
        break;
      }
      $forks = array_merge($forks, $list);
    }

    $nexus = [];
    $problems = 0;
    foreach ($forks as $fork) {
      $full_name = (string) ($fork['full_name'] ?? ''); // the name of today: a renamed fork follows
      $owner = (string) ($fork['owner']['login'] ?? '');
      $branch = (string) ($fork['default_branch'] ?? 'main');
      if ($full_name === '' || $owner === '') {
        continue;
      }
      $relic = "$raw/$full_name/$branch/relic.json";
      list($status, $body) = nexus_fetch($relic);
      if ($status !== 200) {
        nexus_line('info', "$full_name · no relic.json yet");
      }else {
        list($found, $issues) = nexus_relics(nexus_json($body), $owner);
        foreach ($issues as $issue) {
          nexus_line('warn', "$full_name · $issue");
          $problems++;
        }
        nexus_line('ok', "$full_name · " . count($found) . " relic(s)");
      }
      $nexus[$full_name] = [
        'owner'=> $owner,
        'branch'=> $branch,
        'relic'=> $relic,
        'nexus'=> "$raw/$full_name/$branch/nexus.json", // its own forks: reliquaries map each other
      ];
    }
    ksort($nexus, SORT_FLAG_CASE | SORT_STRING);

    nexus_save(['main'=> $main, 'list'=> $nexus]);
    Whisper::echo("{{nl}}{{COLOR-SUCCESS}}nexus.json{{COLOR-END}}: " . count($nexus) . " fork(s), $problems problem(s){{nl}}");
    nexus_publish('update nexus');
  }
);


/* INSPECT
 * Pick one reliquary on the chain (forks of forks too):
 * its relics, and the seal (sha256) of every version.
 * */
Chanter::cast(
  arg: 'inspect --repo',
  echo: 'inspect one reliquary on the chain',
  execute: function() {
    $self = nexus_self();
    if (!$self) {
      return;
    }
    $chain = nexus_chain($self);
    if (!$chain) {
      nexus_line('info', 'No fork in nexus.json yet, run: php nexus update');
      return;
    }
    $names = array_keys($chain);

    $input = nexus_spell('repo');
    if ($input === '') {
      Whisper::echo("{{nl}}");
      foreach ($names as $i => $name) {
        $via = $chain[$name]['via'] !== $self['main'] ? " {{COLOR-SECONDARY}}via {$chain[$name]['via']}{{COLOR-END}}" : '';
        Whisper::echo("  {{COLOR-INFO}}[" . ($i + 1) . "]{{COLOR-END}} $name$via{{nl}}");
      }
      $input = trim((string) Whisper::call('Which reliquary? [ID or owner/repo]: '));
    }
    $name = ctype_digit($input) ? ($names[(int) $input - 1] ?? null) : null;
    foreach ($names as $listed) {
      $name = $name ?? (strcasecmp($listed, $input) === 0 ? $listed : null);
    }
    if (!$name) {
      nexus_line('fail', ($input ?: 'nothing') . ' is not on the chain of ' . $self['main']);
      return;
    }
    $source = $chain[$name];

    Whisper::echo("{{nl}}{{bold}}Inspect{{end}} $name {{COLOR-SECONDARY}}via {$source['via']}{{COLOR-END}}{{nl}}{{nl}}");
    list($status, $body) = nexus_fetch($source['relic']);
    $record = $status === 200 ? nexus_json($body) : null;
    if (!$record) {
      nexus_line('info', "$name · no relic.json (HTTP $status)");
      return;
    }
    list($relics, $issues) = nexus_relics($record, $source['owner']);
    foreach ($issues as $issue) {
      nexus_line('warn', $issue);
    }
    if (!$relics) {
      nexus_line('info', "$name · no relic yet");
      return;
    }

    $count = ['ok'=> 0, 'fail'=> 0];
    foreach ($relics as $relic_name => $relic) {
      Whisper::echo("{{COLOR-INFO}}♦{{COLOR-END}} {{bold}}$relic_name{{end}} · " . ($relic['runite'] ?? 'cast') . '.rune' . "{{nl}}");
      if (!empty($relic['note'])) {
        Whisper::echo("  {{COLOR-SECONDARY}}" . mb_strimwidth($relic['note'], 0, 72, '…') . "{{COLOR-END}}{{nl}}");
      }
      foreach ($relic['tags'] as $version => $item) {
        list($status, $body) = nexus_fetch((string) ($item['url'] ?? ''));
        if ($status !== 200) {
          $problem = "can not be fetched (HTTP $status)";
        }elseif (strpos($body, '[ᚱᚾ]') === false) {
          $problem = 'not a relic (.rune)';
        }elseif (!hash_equals(strtolower((string) ($item['sha256'] ?? '')), hash('sha256', $body))) {
          $problem = 'the seal is broken (sha256)';
        }else {
          $problem = null;
        }
        $ref = !empty($item['ref']) ? " · {$item['ref']}" : '';
        Whisper::echo('  ');
        nexus_line($problem ? 'fail' : 'ok', "$version$ref" . ($problem ? ": $problem" : ''));
        $count[$problem ? 'fail' : 'ok']++;
      }
    }
    Whisper::echo("{{nl}}" . count($relics) . " relic(s) · {$count['ok']} sealed, {$count['fail']} failed{{nl}}");
  }
);



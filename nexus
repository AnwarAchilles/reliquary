/* INITIATE
 * A fork starts with the nexus of its parent: clean up nexus.json,
 * with <username>/<project folder> as the reliquary.
 * */
Chanter::cast(
  arg: 'initiate --user --local',
  echo: 'initiate this fork, clean up nexus.json',
  execute: function() {
    // the repo comes from git remote origin; the folder name only when there is none
    $origin = nexus_origin();
    $user = nexus_spell('user') ?: ($origin[0] ?? '');
    if ($user === '') {
      $main = (string) (nexus_load()['main'] ?? '');
      if (preg_match('#^([^/]+)/[^/]+$#', $main, $match)) {
        Whisper::echo("{{nl}}nexus.json is now the reliquary of {{bold}}$main{{end}}{{nl}}");
        if (strtolower(trim((string) Whisper::call("Is {$match[1]} your GitHub username? [y/n]: "))) === 'y') {
          $user = $match[1];
        }
      }
      if ($user === '') {
        $user = trim((string) Whisper::call('Your GitHub username: '));
      }
    }
    $user = trim($user, '@/ ');
    if (!preg_match('#^[a-z0-9][a-z0-9-]*$#i', $user)) {
      nexus_line('warn', 'A GitHub username is needed: php nexus initiate --user=<username>');
      return;
    }
    $main = "$user/" . ($origin[1] ?? nexus_folder());
    if ($origin) {
      nexus_line('info', "git remote origin: {$origin[0]}/{$origin[1]}");
    }
    nexus_save(['main'=> $main, 'list'=> []]);
    nexus_line('ok', "nexus.json is ready: the reliquary of $main");
    nexus_publish('initiate nexus');
      Whisper::echo("{{COLOR-SECONDARY}}   Keep it in step with its parent: php hall sync{{COLOR-END}}{{nl}}");

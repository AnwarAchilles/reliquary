/*
 * RELIQUARY · HALL ✦
 * Keeping a reliquary whole: in step with its parent, its relics valid, its chain in sight.
 *
 * Run this script using:
 *   $ php hall
 *   $ php hall sync      [--from=<owner>/<repo>]   take the code of the parent, keep your records
 *   $ php hall analize   [--repo=<repo>]           check this reliquary: records, names, every seal
 *   $ php hall chain     [--from=<owner>/<repo>]   the whole chain, nexus by nexus, with its relics
 *
 * Spells for tests (point them at a fake GitHub):
 *   --api=<url>   the GitHub API          (default https://api.github.com)
 *   --raw=<url>   raw files               (default https://raw.githubusercontent.com)
 *   --git=<url>   where repos are fetched (default https://github.com)
 * A GITHUB_TOKEN environment variable is sent to the API when it is set.
 */
require_once __DIR__ . '/vendor/autoload.php';



